{
  "name": "opencode-user-message",
  "version": "0.1.1",
  "description": "OpenCode TUI plugin: list the current session's user messages in the sidebar and jump to any of them",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "user-message",
    "timeline"
  ],
  "packageManager": "bun@1.4.5",
  "engines": {
    "opencode": ">=2.4.0"
  },
  "exports": {
    "./tui": "./tui.tsx"
  },
  "files": [
    "tui.tsx",
    "timeline.ts",
    "mock.ts",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/susususutie/opencode-user-message.git"
  },
  "homepage": "https://github.com/susususutie/opencode-user-message#readme",
  "bugs": {
    "url": "https://github.com/susususutie/opencode-user-message/issues"
  },
  "scripts": {
    "typecheck": "bun check --no-script",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@opencode/plugin": "^2.4.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.9.2",
    "@opentui/solid": ">=0.9.2",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "^2.4.1",
    "@opentui/core": "0.9.9",
    "@opentui/solid": "0.9.9",
    "@types/bun": "^1.4.5",
    "solid-js": "^1.9.17"
  }
}
